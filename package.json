{
  "name": "divid3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, opinionated meta search engine. We divide your query and intelligently route it to the best search providers.",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-html": "^8.2.1",
    "globals": "^17.13.0",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "playwright test",
    "test:unit": "python3 -m unittest discover -s tests/unit -v",
    "test:ci": "CI=1 playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "serve": "serve -l 3000 .",
    "lint": "npm run lint:js && npm run typecheck && npm run lint:py && npm run lint:config",
    "lint:js": "eslint index.html setup.html eslint.config.js",
    "lint:py": "ruff check scripts tests/unit",
    "lint:config": "python3 scripts/validate_config.py",
    "typecheck": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradflaugher/divid3.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bradflaugher/divid3/issues"
  },
  "homepage": "https://divid3.com/"
}
