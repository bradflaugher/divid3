{
  // Type-checks the Playwright specs and config (`npm run typecheck`).
  // Nothing is emitted; Playwright runs the .ts files directly.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["tests/**/*.ts", "playwright.config.ts"]
}
