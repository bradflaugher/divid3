# Cache control for Cloudflare Pages.
#
# Cloudflare Pages applies EVERY rule that matches a path, and when two
# matching rules set the same header the values are comma-joined (not
# overridden). So the catch-all below must not set Cache-Control: it would
# be glued onto every narrower rule (`max-age=0, …, max-age=31536000`).
# Pages already defaults to `public, max-age=0, must-revalidate`, which is
# what HTML wants. Each path below should match at most one Cache-Control
# rule.
#
# Goal:
#   - HTML: always revalidate (so iOS Safari can't pin a stale page).
#   - search-embeddings.json: short TTL + must-revalidate. The file is
#     content-addressed via a `?v=…` query string in index.html, so a
#     long TTL would otherwise be safe — but iOS sometimes serves stale
#     immutable JSON across version bumps, so we explicitly keep this
#     short to give us a ~hourly safety net.
#   - Model weights / tokenizer files under /models/: immutable. Each is
#     ~22 MB and effectively content-addressed by path; they never change
#     in place.
#   - Visual assets: 1 week is plenty.

# Security headers for every response. No script-src here on purpose: the
# app is an inline <script type="module"> that would need a hash pinned to
# every edit. frame-ancestors blocks clickjacking (e.g. of the Retry button,
# which wipes caches).
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# Long-lived immutable assets — model weights + tokenizer files.
# Path is effectively content-addressed (we never mutate a file in place).
/models/*
  Cache-Control: public, max-age=31536000, immutable

# Update-prone routing data. index.html appends `?v=…` to bust this on
# real changes; the short max-age is a belt-and-suspenders defense
# against iOS Safari's occasionally-creative cache behavior.
/search-embeddings.json
  Cache-Control: public, max-age=3600, must-revalidate

# Engine + bang + keyword-rule tables. Same `?v=…` bump policy as the
# embeddings file; short max-age keeps iOS Safari honest after a config
# change.
/search-config.json
  Cache-Control: public, max-age=3600, must-revalidate

# Static visual assets and install metadata
/fonts/*
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/search.webmanifest
  Cache-Control: public, max-age=604800
/browserconfig.xml
  Cache-Control: public, max-age=604800

# OpenSearch description: served as XML so Chromium / Firefox can
# auto-discover divid3 as a search engine. Browsers refetch this rarely
# (only when adding an engine), so 1 day is plenty.
/opensearch.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/opensearchdescription+xml; charset=utf-8
